{
  "name": "@edihasaj/recall",
  "version": "2.0.16",
  "description": "Cross-tool coding memory and instruction compiler",
  "license": "MIT",
  "homepage": "https://recallmemory.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edihasaj/recall.git"
  },
  "bugs": {
    "url": "https://github.com/edihasaj/recall/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "recall": "dist/cli.js"
  },
  "files": [
    "dist",
    "drizzle",
    "scripts/recall-claude",
    "scripts/recall-codex",
    "scripts/recall-session",
    "scripts/install.ps1",
    "vendor/recall-cloud-sync",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && npm run webui:build && node -e \"const f='dist/cli.js';const c=require('fs').readFileSync(f,'utf8');if(!c.startsWith('#!'))require('fs').writeFileSync(f,'#!/usr/bin/env node\\n'+c);require('fs').chmodSync(f,0o755)\"",
    "webui:build": "cd webui && (test -d node_modules || npm install --no-audit --no-fund) && npm run build",
    "webui:dev": "cd webui && npm run dev",
    "build:app": "bash scripts/build-app.sh",
    "install:app": "bash scripts/install-app.sh",
    "dev": "tsup --watch",
    "docs:check": "node scripts/check-docs-site.mjs",
    "docs:og": "npx -y playwright screenshot --viewport-size=1200,630 --wait-for-timeout 1800 file://$PWD/docs/og.html docs/og-image.png",
    "homebrew:cask": "node scripts/render-homebrew-cask.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:seed": "tsx benchmark/seed.ts",
    "bench:load": "tsx benchmark/load.ts",
    "demo:record": "bash scripts/record-demo.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sentry/node": "10.65.0",
    "@universalmemoryprotocol/core": "https://github.com/edihasaj/universal-memory-protocol/releases/download/v1.0.4/universalmemoryprotocol-core-1.0.4.tgz",
    "better-sqlite3": "11.10.0",
    "commander": "13.1.0",
    "drizzle-orm": "0.45.2",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.6"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "@protobufjs/utf8": "1.1.2",
    "adm-zip": "0.6.1",
    "body-parser": "2.4.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "nanoid": "3.3.18",
    "postcss": "8.5.31",
    "protobufjs": "7.6.5",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "vite": "7.3.7"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11",
      "@protobufjs/utf8": "1.1.2",
      "adm-zip": "0.6.1",
      "body-parser": "2.4.0",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.9",
      "hono": "4.13.13",
      "ip-address": "10.7.4",
      "nanoid": "3.3.18",
      "postcss": "8.5.31",
      "protobufjs": "7.6.5",
      "proxy-addr": "2.0.8",
      "qs": "6.16.1",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2",
      "vite": "7.3.7"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@photostructure/sqlite-vec": "2.0.1"
  }
}
